{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src", "test", "tsup.config.ts", "vitest.config.ts"]
}
