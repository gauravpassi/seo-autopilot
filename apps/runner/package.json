{
  "name": "@seo-autopilot/runner",
  "version": "0.1.0",
  "private": true,
  "description": "SEO Autopilot runner: claims jobs from the control panel and runs claude-seo + adapters on your PC.",
  "type": "module",
  "bin": {
    "seo-autopilot-runner": "dist/runner.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/runner.js start",
    "dev": "tsx src/cli.ts start",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@seo-autopilot/core": "0.1.0",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
