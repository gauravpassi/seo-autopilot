# ---------------------------------------------------------------- Supabase
# Project settings → API. The anon key is public; RLS limits it to the user's org (read-only).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only (route handlers, server actions). Bypasses RLS — never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- App
# Public base URL of the panel, used in Slack/WhatsApp/email links. No trailing slash.
APP_URL=https://autopilot.example.com

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts Slack/WhatsApp/email secrets stored in
# org_settings.channels. Changing it makes stored channel secrets unreadable (re-enter them in Settings).
APP_ENCRYPTION_KEY=

# HMAC secret for signed email approval links (openssl rand -base64 32). Rotating it invalidates
# outstanding email links (people can still approve in the panel / Slack / WhatsApp).
ACTION_TOKEN_SECRET=

# Bearer secret Vercel Cron sends to /api/cron/digest (Vercel sets the header automatically when
# CRON_SECRET exists in the project env). openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------- Optional
# Meta Graph API version for WhatsApp Cloud API (default v26.0).
# WA_GRAPH_VERSION=v26.0

# Channel credentials (Slack bot token / signing secret, WhatsApp token / app secret / verify token,
# Resend API key or SMTP password) are NOT env vars: enter them in the panel under Settings →
# Notifications. They are stored encrypted with APP_ENCRYPTION_KEY.
